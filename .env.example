# Токен вашего Telegram бота (получить у @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Входящий вебхук из Битрикс24 (CRM -> Разработчикам -> Другое -> Входящий вебхук)
# Права вебхука: CRM
BITRIX_WEBHOOK_URL=https://b24-xxxx.bitrix24.ru/rest/1/abcdef123456789/

# (Опционально) ID разрешённых Telegram групп через запятую.
# Если пусто — бот работает во всех группах, куда добавлен.
ALLOWED_CHAT_IDS=

# (Опционально) Ключ AI для интеллектуального понимания любого сленга и опечаток:
# Получить бесплатно на aistudio.google.com
GEMINI_API_KEY=
# Или OpenAI:
OPENAI_API_KEY=

# Коды пользовательских полей сделки в Битрикс24 (UF_CRM_...)
# Создаются в Битрикс24: Настройки CRM -> Пользовательские поля -> Сделка
UF_CRM_TAGS=UF_CRM_TAGS
UF_CRM_MATTRESS_SIZE=UF_CRM_MATTRESS_SIZE
UF_CRM_MATERIAL=UF_CRM_MATERIAL
UF_CRM_MATTRESS_DETAILS=UF_CRM_MATTRESS_DETAILS
UF_CRM_PREPAYMENT=UF_CRM_PREPAYMENT
UF_CRM_PAYMENT_TYPE=UF_CRM_PAYMENT_TYPE
UF_CRM_BALANCE=UF_CRM_BALANCE
UF_CRM_DELIVERY_ADDR=UF_CRM_DELIVERY_ADDR
UF_CRM_DELIVERY_DATE=UF_CRM_DELIVERY_DATE
